; water512 NVE with pGM electrostatics (rigid water, plain LJ cut-off as in pmemd / the OpenMM NVE test)
integrator              = md
nsteps                  = 4000
dt                      = 0.001
cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.0001
nstlist                 = 10
pbc                     = xyz
coulombtype             = pGM
rcoulomb                = 0.9
vdwtype                 = cut-off
vdw-modifier            = None
rvdw                    = 0.9
DispCorr                = no
fourier-nx              = 36
fourier-ny              = 36
fourier-nz              = 36
pme-order               = 6
ewald-rtol              = 8.398211315215934e-06
pgm-dipole-tol          = 1e-5
pgm-predictor           = 2
pgm-peek                = 0.65
tcoupl                  = no
pcoupl                  = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = 2026
continuation            = no
nstcalcenergy           = 10
nstenergy               = 10
nstlog                  = 500
