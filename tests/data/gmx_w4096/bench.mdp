; pmemd gpubench mdin_s4k_040_9_56: cut 9 A, ew_coeff 0.40 /A, 56^3, order 6, tol 1e-4, 1 fs, NVE
integrator              = md
nsteps                  = 2000
dt                      = 0.001
cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz
coulombtype             = pGM
rcoulomb                = 0.9
vdwtype                 = cut-off
vdw-modifier            = None
rvdw                    = 0.9
DispCorr                = EnerPres
fourier-nx              = 56
fourier-ny              = 56
fourier-nz              = 56
pme-order               = 6
ewald-rtol              = 3.5586e-07
pgm-dipole-tol          = 1e-4
pgm-predictor           = 2
pgm-peek                = 0.65
tcoupl                  = no
pcoupl                  = no
gen-vel                 = yes
gen-temp                = 300
gen-seed                = 71277
continuation            = no
nstcalcenergy           = 100
nstenergy               = 100
nstlog                  = 1000
