+!*******************************************************************************
+!
+! Subroutine:  fill_bspline_2_3d
+!
+! Description: calculate B-spline upto 2nd derivatives
+!
+! Use standard B-spline recursions: see doc file.
+! w is fraction between 0 and 1; 
+! order is the order of interpolation;
+! array is the array of shifted bsplines;
+! darray is array of derivs;
+! d2array is array of 2nd derivs;
+! Using notation from Essmann et al; w = u-[u] and
+! array(j) = M_n(w + order - j)  where n is order & w = u - [u]; 
+!              
+!*******************************************************************************
+
+subroutine fill_bspline_2_3d(w, order, array, darray, d2array)
+
+  implicit none
+
+  integer               order
+  double precision      w(3)
+  double precision      array(order,3)
+  double precision      darray(order,3)
+  double precision      d2array(order,3)
+
+  double precision      div, ww, w2
+  integer               k
+  integer               i
+
+  if (order .eq. 4) then
+
+  do i = 1, 3
+! Init order 2:
+
+    array(2,i) = w(i)
+    array(1,i) = 1.d0 - w(i)
+
+! In full:
+!   order three deriv
+!      darray(1) = -array(1)
+!      darray(2) = array(1) - array(2)
+!      darray(3) = array(2)
+!   deriv of deriv
+!      d2array(1) = -darray(1)
+!      d2array(2) = darray(1) - darray(2)
+!      d2array(3) = darray(2) - darray(3)
+!      d2array(4) = darray(3)
+! In short:
+
+    d2array(1,i) = array(1,i)
+    d2array(2,i) = array(2,i) - 2.d0 * array(1,i)
+    d2array(3,i) = array(1,i) - 2.d0 * array(2,i)
+    d2array(4,i) = array(2,i)
+
+! One pass to order 3:
+
+    array(3,i) = 0.5d0 * w(i) * array(2,i)
+    array(2,i) = 0.5d0 * ((w(i) + 1.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = 0.5d0 * (1.d0 - w(i)) * array(1,i)
+
+! Order four deriv:
+
+    darray(1,i) = - array(1,i)
+    darray(2,i) = array(1,i) - array(2,i)
+    darray(3,i) = array(2,i) - array(3,i)
+    darray(4,i) = array(3,i)
+
+! One pass to order 4:
+
+    div = 1.d0/3.d0
+    array(4,i) = div * w(i) * array(3,i)
+    array(3,i) = div * ((w(i) + 1.d0) * array(2,i) + (3.d0 - w(i)) * array(3,i))
+    array(2,i) = div * ((w(i) + 2.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = div * (1.d0 - w(i)) * array(1,i)
+
+  end do
+
+    return
+  else if (order .eq. 5) then
+
+  do i = 1, 3
+! Init order 2:
+
+!    array(2) = w
+!    array(1) = 1.d0 - w
+
+! One pass to order 3:
+
+!    array(3) = 0.5d0 * w * array(2)
+!    array(2) = 0.5d0 * ((w + 1.d0) * array(1) + (2.d0 - w) * array(2))
+!    array(1) = 0.5d0 * (1.d0 - w) * array(1)
+
+! Together:
+
+    ww = w(i) * w(i)
+    array(3,i) = 0.5d0 * ww
+    array(2,i) = 0.5d0 + w(i) - ww
+    array(1,i) = 0.5d0 * (1.d0 + ww) - w(i)
+
+! 2nd deriv, order 5
+
+     d2array(1,i) = array(1,i)
+     d2array(2,i) = array(2,i) - 2.d0 * array(1,i)
+     d2array(3,i) = array(1,i) - 2.d0 * array(2,i) + array(3,i)
+     d2array(4,i) = array(2,i) - 2.d0 * array(3,i)
+     d2array(5,i) = array(3,i)
+
+! One pass to order 4:
+
+    div = 1.d0/3.d0
+    array(4,i) = div * w(i) * array(3,i)
+    array(3,i) = div * ((w(i) + 1.d0) * array(2,i) + (3.d0 - w(i)) * array(3,i))
+    array(2,i) = div * ((w(i) + 2.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = div * (1.d0 - w(i)) * array(1,i)
+
+! Order four deriv:
+
+    darray(1,i) = - array(1,i)
+    darray(2,i) = array(1,i) - array(2,i)
+    darray(3,i) = array(2,i) - array(3,i)
+    darray(4,i) = array(3,i) - array(4,i)
+    darray(5,i) = array(4,i)
+
+! One pass to order 5:
+
+    div = 0.25d0
+    array(5,i) = div * w(i) * array(4,i)
+    array(4,i) = div * ((w(i) + 1.0d0) * array(3,i) + (4.0d0 - w(i)) * array(4,i))
+    array(3,i) = div * ((w(i) + 2.0d0) * array(2,i) + (3.0d0 - w(i)) * array(3,i))
+    array(2,i) = div * ((w(i) + 3.0d0) * array(1,i) + (2.0d0 - w(i)) * array(2,i))
+    array(1,i) = div * (1.0d0 - w(i)) * array(1,i)
+
+  end do
+
+    return
+  else
+
+! Init order 2:
+  do i = 1, 3
+    array(2,i) = w(i)
+    array(1,i) = 1.d0 - w(i)
+
+! One pass to order 3:
+
+    array(3,i) = 0.5d0 * w(i) * array(2,i)
+    array(2,i) = 0.5d0 * ((w(i) + 1.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = 0.5d0 * (1.d0 - w(i)) * array(1,i)
+
+! Compute standard b-spline recursion:
+
+    do k = 4, order - 2
+      call one_pass_bspline(array(1,i), w(i), k)
+    end do
+
+! Perform standard b-spline differentiation:
+
+    call diff_bspline(array(1,i), darray(1,i), order - 1) 
+! Deriv of deriv:
+
+    call diff_bspline(darray(1,i), d2array(1,i), order)
+
+! Perform standard b-spline differentiation:
+
+    call one_pass_bspline(array(1,i), w(i), order - 1)
+    call diff_bspline(array(1,i), darray(1,i), order)
+
+! One more recursion:
+
+    call one_pass_bspline(array(1,i), w(i), order)
+
+  end do
+
+    return
+
+  end if
+
+end subroutine fill_bspline_2_3d
+
+!*******************************************************************************
+!
+! Subroutine:  fill_bspline_3
+!
+! Description: calculate B-spline upto 3rd derivatives
+!
+! Use standard B-spline recursions: see doc file.
+! w is fraction between 0 and 1; 
+! order is the order of interpolation;
+! array is the array of shifted bsplines;
+! darray is array of derivs;
+! d2array is array of 2nd derivs;
+! d3array is array of 3rd derivs;
+! Using notation from Essmann et al; w = u-[u] and
+! array(j) = M_n(w + order - j)  where n is order & w = u - [u]; 
+!
+! added for PGM
+!              
+!*******************************************************************************
+
+subroutine fill_bspline_3(w, order, array, darray, d2array, d3array)
+
+  implicit none
+
+  integer               order
+  double precision      w
+  double precision      array(order)
+  double precision      darray(order)
+  double precision      d2array(order)
+  double precision      d3array(order)
+
+  double precision      div
+  integer               k
+
+  if (order .eq. 5) then
+
+! Init order 2:
+
+    array(2) = w
+    array(1) = 1.d0 - w
+
+! In full:
+!   order three deriv
+!      darray(1) = -array(1)
+!      darray(2) = array(1) - array(2)
+!      darray(3) = array(2)
+!   deriv of deriv
+!      d2array(1) = -darray(1)
+!      d2array(2) = darray(1) - darray(2)
+!      d2array(3) = darray(2) - darray(3)
+!      d2array(4) = darray(3)
+!   deriv 3rd
+!    d3array(1) = -d2array(1)  = -array(1)
+!    d3array(2) = d2array(1) - d2array(2) = 3.d0 * array(1) - array(2)
+!    d3array(3) = d2array(2) - d2array(3) = 3.d0 * array(2) - 3.d0 * array(1)
+!    d3array(4) = d2array(3) - d2array(4) = array(1) - 3.d0 * array(2)
+!    d3array(5) = d2arrau(4) = array(2)
+! In short:
+
+!    d2array(1) = array(1)
+!    d2array(2) = array(2) - 2.d0 * array(1)
+!    d2array(3) = array(1) - 2.d0 * array(2)
+!    d2array(4) = array(2)
+
+    d3array(1) = -array(1)
+    d3array(2) = 3.d0 * array(1) - array(2)
+    d3array(3) = 3.d0 * array(2) - 3.d0 * array(1)
+    d3array(4) = array(1) - 3.d0 * array(2)
+    d3array(5) = array(2)
+
+! One pass to order 3:
+
+    array(3) = 0.5d0 * w * array(2)
+    array(2) = 0.5d0 * ((w + 1.d0) * array(1) + (2.d0 - w) * array(2))
+    array(1) = 0.5d0 * (1.d0 - w) * array(1)
+
+! 1st deriv
+!    darray(1) = - array(1)
+!    darray(2) = array(1) - array(2)
+!    darray(3) = array(2) - array(3)
+!    darray(4) = array(3)
+! 2nd deriv
+!    d2array(1) = -darray(1)
+!    d2array(2) = darray(1) - darray(2)
+!    d2array(3) = darray(2) - darray(3)
+!    d2array(4) = darray(3) - darray(4)
+!    d2array(5) = darray(4)
+
+! in short:
+
+     d2array(1) = array(1)
+     d2array(2) = array(2) - 2.d0 * array(1)
+     d2array(3) = array(1) - 2.d0 * array(2) + array(3)
+     d2array(4) = array(2) - 2.d0 * array(3)
+     d2array(5) = array(3)
+
+! One pass to order 4:
+
+    div = 1.d0/3.d0
+    array(4) = div * w * array(3)
+    array(3) = div * ((w + 1.d0) * array(2) + (3.d0 - w) * array(3))
+    array(2) = div * ((w + 2.d0) * array(1) + (2.d0 - w) * array(2))
+    array(1) = div * (1.d0 - w) * array(1)
+
+! Order four deriv:
+
+    darray(1) = - array(1)
+    darray(2) = array(1) - array(2)
+    darray(3) = array(2) - array(3)
+    darray(4) = array(3) - array(4)
+    darray(5) = array(4)
+
+! One pass to order 5:
+
+    div = 0.25d0
+    array(5) = div * w * array(4)
+    array(4) = div * ((w + 1.0d0) * array(3) + (4.0d0 - w) * array(4))
+    array(3) = div * ((w + 2.0d0) * array(2) + (3.0d0 - w) * array(3))
+    array(2) = div * ((w + 3.0d0) * array(1) + (2.0d0 - w) * array(2))
+    array(1) = div * (1.0d0 - w) * array(1)
+
+    return
+
+  else
+
+! Init order 2:
+
+    array(2) = w
+    array(1) = 1.d0 - w
+
+! One pass to order 3:
+
+    array(3) = 0.5d0 * w * array(2)
+    array(2) = 0.5d0 * ((w + 1.d0) * array(1) + (2.d0 - w) * array(2))
+    array(1) = 0.5d0 * (1.d0 - w) * array(1)
+
+! Compute standard b-spline recursion up to order-3:
+
+    do k = 3, order - 3
+      call one_pass_bspline(array, w, k)
+    end do
+
+! 3rd deriv
+    call diff_bspline(array, darray, order-2)
+    call diff_bspline(darray, d2array, order-1)
+    call diff_bspline(d2array, d3array, order)
+
+    call one_pass_bspline(array, w, order-2)
+
+! Perform standard b-spline differentiation:
+
+    call diff_bspline(array, darray, order - 1) 
+! Deriv of deriv:
+
+    call diff_bspline(darray, d2array, order)
+
+! Perform standard b-spline differentiation:
+
+    call one_pass_bspline(array, w, order - 1)
+    call diff_bspline(array, darray, order)
+
+! One more recursion:
+
+    call one_pass_bspline(array, w, order)
+
+    return
+
+  end if
+
+end subroutine fill_bspline_3
+
+!*******************************************************************************
+!
+! Subroutine:  fill_bspline_3_3d
+!
+! Description: calculate B-spline upto 3rd derivatives
+!
+! Use standard B-spline recursions: see doc file.
+! w is fraction between 0 and 1; 
+! order is the order of interpolation;
+! array is the array of shifted bsplines;
+! darray is array of derivs;
+! d2array is array of 2nd derivs;
+! d3array is array of 3rd derivs;
+! Using notation from Essmann et al; w = u-[u] and
+! array(j) = M_n(w + order - j)  where n is order & w = u - [u]; 
+!
+! added for PGM
+!              
+!*******************************************************************************
+
+subroutine fill_bspline_3_3d(w, order, array, darray, d2array, d3array)
+
+  implicit none
+
+  integer               order
+  double precision      w(3)
+  double precision      array(order,3)
+  double precision      darray(order,3)
+  double precision      d2array(order,3)
+  double precision      d3array(order,3)
+
+  double precision      div
+  integer               k
+  integer               i
+
+  if (order .eq. 5) then
+
+   do i = 1, 3
+! Init order 2:
+
+    array(2,i) = w(i)
+    array(1,i) = 1.d0 - w(i)
+
+! In full:
+!   order three deriv
+!      darray(1) = -array(1)
+!      darray(2) = array(1) - array(2)
+!      darray(3) = array(2)
+!   deriv of deriv
+!      d2array(1) = -darray(1)
+!      d2array(2) = darray(1) - darray(2)
+!      d2array(3) = darray(2) - darray(3)
+!      d2array(4) = darray(3)
+!   deriv 3rd
+!    d3array(1) = -d2array(1)  = -array(1)
+!    d3array(2) = d2array(1) - d2array(2) = 3.d0 * array(1) - array(2)
+!    d3array(3) = d2array(2) - d2array(3) = 3.d0 * array(2) - 3.d0 * array(1)
+!    d3array(4) = d2array(3) - d2array(4) = array(1) - 3.d0 * array(2)
+!    d3array(5) = d2arrau(4) = array(2)
+! In short:
+
+!    d2array(1) = array(1)
+!    d2array(2) = array(2) - 2.d0 * array(1)
+!    d2array(3) = array(1) - 2.d0 * array(2)
+!    d2array(4) = array(2)
+
+    d3array(1,i) = -array(1,i)
+    d3array(2,i) = 3.d0 * array(1,i) - array(2,i)
+    d3array(3,i) = 3.d0 * (array(2,i) - array(1,i))
+    d3array(4,i) = array(1,i) - 3.d0 * array(2,i)
+    d3array(5,i) = array(2,i)
+
+! One pass to order 3:
+
+    array(3,i) = 0.5d0 * w(i) * array(2,i)
+    array(2,i) = 0.5d0 * ((w(i) + 1.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = 0.5d0 * (1.d0 - w(i)) * array(1,i)
+
+! 1st deriv
+!    darray(1) = - array(1)
+!    darray(2) = array(1) - array(2)
+!    darray(3) = array(2) - array(3)
+!    darray(4) = array(3)
+! 2nd deriv
+!    d2array(1) = -darray(1)
+!    d2array(2) = darray(1) - darray(2)
+!    d2array(3) = darray(2) - darray(3)
+!    d2array(4) = darray(3) - darray(4)
+!    d2array(5) = darray(4)
+
+! in short:
+
+     d2array(1,i) = array(1,i)
+     d2array(2,i) = array(2,i) - 2.d0 * array(1,i)
+     d2array(3,i) = array(1,i) - 2.d0 * array(2,i) + array(3,i)
+     d2array(4,i) = array(2,i) - 2.d0 * array(3,i)
+     d2array(5,i) = array(3,i)
+
+! One pass to order 4:
+
+    div = 1.d0/3.d0
+    array(4,i) = div * w(i) * array(3,i)
+    array(3,i) = div * ((w(i) + 1.d0) * array(2,i) + (3.d0 - w(i)) * array(3,i))
+    array(2,i) = div * ((w(i) + 2.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = div * (1.d0 - w(i)) * array(1,i)
+
+! Order four deriv:
+
+    darray(1,i) = - array(1,i)
+    darray(2,i) = array(1,i) - array(2,i)
+    darray(3,i) = array(2,i) - array(3,i)
+    darray(4,i) = array(3,i) - array(4,i)
+    darray(5,i) = array(4,i)
+
+    div = 0.25d0
+
+    array(5,i) = div * w(i) * array(4,i)
+    array(4,i) = div * ((w(i) + 1.0d0) * array(3,i) + (4.0d0 - w(i)) * array(4,i))
+    array(3,i) = div * ((w(i) + 2.0d0) * array(2,i) + (3.0d0 - w(i)) * array(3,i))
+    array(2,i) = div * ((w(i) + 3.0d0) * array(1,i) + (2.0d0 - w(i)) * array(2,i))
+    array(1,i) = div * (1.0d0 - w(i)) * array(1,i)
+
+    end do
+
+    return
+
+  else
+
+    do i = 1, 3
+! Init order 2:
+
+    array(2,i) = w(i)
+    array(1,i) = 1.d0 - w(i)
+
+! One pass to order 3:
+
+    array(3,i) = 0.5d0 * w(i) * array(2,i)
+    array(2,i) = 0.5d0 * ((w(i) + 1.d0) * array(1,i) + (2.d0 - w(i)) * array(2,i))
+    array(1,i) = 0.5d0 * (1.d0 - w(i)) * array(1,i)
+
+! Compute standard b-spline recursion up to order-3:
+
+    do k = 4, order - 3
+      call one_pass_bspline(array(1,i), w(i), k)
+    end do
+
+! 3rd deriv
+
+    call diff_bspline(array(1,i), darray(1,i), order-2)
+    call diff_bspline(darray(1,i), d2array(1,i), order-1)
+    call diff_bspline(d2array(1,i), d3array(1,i), order)
+
+    call one_pass_bspline(array(1,i), w(i), order-2)
+
+! Perform standard b-spline differentiation:
+
+    call diff_bspline(array(1,i), darray(1,i), order - 1) 
+! Deriv of deriv:
+
+    call diff_bspline(darray(1,i), d2array(1,i), order)
+
+! Perform standard b-spline differentiation:
+
+    call one_pass_bspline(array(1,i), w(i), order - 1)
+    call diff_bspline(array(1,i), darray(1,i), order)
+
+! One more recursion:
+
+    call one_pass_bspline(array(1,i), w(i), order)
+
+    end do
+
+    return
+
+  end if
+
+end subroutine fill_bspline_3_3d
+#endif  /* PGM */
+
 !*******************************************************************************
 !
 ! Subroutine:  diff_bspline
diff --git a/src/pmemd/src/cit.F90 b/src/pmemd/src/cit.F90
index eb91995..0ea6be0 100644
--- a/src/pmemd/src/cit.F90
+++ b/src/pmemd/src/cit.F90
@@ -158,6 +158,24 @@ subroutine set_cit_tbl_dims(pbc_box, list_cutoff, cut_factor)
   cit_tbl_z_dim = floor(pbc_box(3) / &
                   (cut_factor(3) * list_cutoff * 0.5d0 + rnd_fudge))
 #endif
+
+#ifdef PGM  /* a temporary "fix" to the missing nonbonded pair problem. YD */
+! The problem occurs for a box of 512 TIP3P water molecules in truncated octahedral box of 26.9668445**3.
+! With 9+1A cutoff, the "standard" 5x5x5 cit_tbl dims produce 7 pairs fewer than the full pairwise method.
+!  not sure the root cause of this problem. Updating bkt_size() did not help.
+!  bkt_size(1) = pbc_box(1)/cit_tbl_x_dim
+!  bkt_size(2) = pbc_box(2)/cit_tbl_y_dim
+!  bkt_size(3) = pbc_box(3)/cit_tbl_z_dim
+
+if (cit_tbl_x_dim .gt. 1) cit_tbl_x_dim = cit_tbl_x_dim - 1
+if (cit_tbl_y_dim .gt. 1) cit_tbl_y_dim = cit_tbl_y_dim - 1
+if (cit_tbl_z_dim .gt. 1) cit_tbl_z_dim = cit_tbl_z_dim - 1
+! update bkt_size() to be consistent with cit_tbl dims.
+  bkt_size(1) = cut_factor(1)*pbc_box(1)/cit_tbl_x_dim
+  bkt_size(2) = cut_factor(2)*pbc_box(2)/cit_tbl_y_dim
+  bkt_size(3) = cut_factor(3)*pbc_box(3)/cit_tbl_z_dim
+#endif
+
   return
 
 end subroutine set_cit_tbl_dims
