+// Stream-aware wrappers for PGM CUDA graph capture
+//---------------------------------------------------------------------------------------------
+#ifdef GTI
+extern "C" void kPMEClearChargeGridBuffer_s(gpuContext gpu, cudaStream_t s)
+{
+#ifdef use_DPFP
+  cudaMemsetAsync(gpu->sim.plliXYZ_q, 0, gpu->sim.XYZStride * sizeof(long long int), s);
+#else
+  cudaMemsetAsync(gpu->sim.plliXYZ_q, 0, gpu->sim.XYZStride * sizeof(int), s);
+#endif
+  LAUNCHERROR("kPMEClearChargeGridBuffer_s");
+}
+
+extern "C" void kPMEReduceChargeGridBuffer_s(gpuContext gpu, cudaStream_t s)
+{
+  int blocks = (gpu->sim.nfft1 * gpu->sim.nfft2 * gpu->sim.nfft3 + 127) >> 7;
+  int offset = 0;
+  if (gpu->sim.pmeOrder == 4) {
+    kPMEReorderChargeGridBuffer444_kernel<<<256, TRANSPOSE_QMESH_THREADS_PER_BLOCK, 0, s>>>();
+  }
+  else {
+    while (blocks > 0) {
+      int lblocks = min(blocks, 65535);
+      kPMEReduceChargeGridBuffer666_kernel<<<lblocks, 128, 0, s>>>(offset);
+      LAUNCHERROR("kPMEReduceChargeGridBuffer_s");
+      offset += 65535;
+      blocks -= 65535;
+    }
+  }
+}
+
+extern "C" void kPMEScalarSumRC_s(gpuContext gpu, PMEDouble vol, cudaStream_t s)
+{
+  int nblocks = gpu->blocks;
+  int nthreads = gpu->generalThreadsPerBlock;
+
+  // PGM: NVE only (ntp=0), no TI (ti_mode=0) -- always the simple path
+  kPMEScalarSumRC_kernel<<<nblocks, nthreads, 0, s>>>();
+  LAUNCHERROR("kPMEScalarSumRC_s");
+}
+
+#endif  // GTI
